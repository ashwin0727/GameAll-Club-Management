<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The debug and profile builds get this from their own manifests; a release build has no network without it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- "Use my current location" in the city picker: approximate (coarse) is enough to find the nearest city, so the precise-location permission is deliberately not requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+: the app must ask before it can show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The screen is locked to portrait, which Play would read as "this app REQUIRES a portrait screen" and hide it from devices without one.
         It is only a preference, so say so: the app stays portrait, and the Play Console warning goes away. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false"/>
    <!-- Asking for the approximate location would otherwise mark location hardware as REQUIRED and hide the app from devices without it. It is only used
         to suggest the nearest city; the player can always pick a city by hand. -->
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.network" android:required="false"/>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="GameAll"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Notifications that arrive while the app is closed use this channel (created in push_service.dart). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="gameall_player_default" />
        <!-- Status-bar icon and accent colour for pushes that arrive while the app is closed (without these Android shows the launcher icon as a white square). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_gameall" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
