<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: pure black, no icon — the Flutter video
         splash renders the moment the engine's first frame is ready. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF000000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
