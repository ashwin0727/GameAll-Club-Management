# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build the redirect URLs in confirmation and password
# reset emails. Only used during server rendering — the browser uses its own
# origin. Must also be listed under Authentication → URL Configuration in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Tournament Management (separate app — GameAll only links out to it)
# Leave any of these blank to hide the matching call to action. No URL is invented.
NEXT_PUBLIC_TOURNAMENT_WEB_URL=
NEXT_PUBLIC_TOURNAMENT_DEEP_LINK=
NEXT_PUBLIC_TOURNAMENT_ANDROID_URL=
NEXT_PUBLIC_TOURNAMENT_IOS_URL=
# Optional: override the in-app preview screenshot (defaults to /tournament-app-home.png)
NEXT_PUBLIC_TOURNAMENT_PREVIEW_IMAGE=

# Firebase (push notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=